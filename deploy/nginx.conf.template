# 배포에서 인터넷에 노출되는 유일한 지점.
#
# 왜 이 파일이 중요한가 —
# ai-api(8001)와 stt-mask-api(8002)에는 인증이 없다. 포트를 바깥에 열면 누구나
# 분석·전사를 돌릴 수 있고, 상담 원문이 그대로 새어 나간다. 그래서 브라우저는
# core-api 하나만 부르고, 나머지는 도커 네트워크 안에서만 통한다.
# docker-compose.yml에서 그 컨테이너들의 ports를 열지 않는 것과 한 쌍이다.
#
# 예외가 하나 있다: Twilio가 걸어 들어오는 /webhook. 전화 오디오를 받아야 해서
# 바깥에서 닿아야 한다. 포트를 여는 대신 여기서 그 경로 하나만 뚫는다.
#
# ── 왜 .template인가 ────────────────────────────────────────────────────────
# 붙을 곳이 배포 형태마다 다르다.
#   한 대에 전부      core-api:8080          (같은 도커 네트워크의 컨테이너 이름)
#   AWS 두 대         10.0.11.x:8080         (프라이빗 서브넷 앱 서버의 사설 IP)
# 설정을 두 벌 두면 한쪽만 고치는 일이 생기므로 그 두 줄만 변수로 뺐다.
#
# 공식 nginx 이미지의 엔트리포인트가 /etc/nginx/templates/*.template을 envsubst로
# 치환해 conf.d에 넣는다. NGINX_ENVSUBST_FILTER로 아래 둘만 치환하게 막아야 한다 —
# 안 그러면 $host, $remote_addr 같은 nginx 자체 변수까지 빈 값으로 날아간다.

upstream core_api {
    server ${CORE_API_UPSTREAM};
}

upstream voip_gateway {
    server ${VOIP_UPSTREAM};
}

# WebSocket 업그레이드용. Connection 헤더는 hop-by-hop이라 그대로 넘기면 안 되고,
# Upgrade 요청일 때만 "upgrade"로 바꿔 보내야 한다. 일반 요청에 이 값을 넣으면
# 프록시가 연결을 끊는다.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP로 온 것은 전부 HTTPS로 넘긴다.
#
# 이게 없으면 녹음 기능이 통째로 죽는다 — 브라우저는 localhost가 아닌 곳에서는
# HTTPS일 때만 마이크를 내준다(getUserMedia). HTTP로 배포하면 녹음 버튼을 눌러도
# 아무 일이 일어나지 않는다. 로그인 토큰과 상담 원문이 평문으로 오가는 것도 함께 걸린다.
server {
    listen 80;
    server_name _;

    # 컨테이너 헬스체크는 여기로 온다. 전부 리다이렉트로 돌리면 헬스체크가
    # https://localhost 로 따라가서 인증서 이름이 안 맞아 SSL_connect에서 죽는다.
    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # 리다이렉트를 location 안에 둔다. server 레벨에 두면 rewrite 단계에서
    # 먼저 실행돼 location 선택 자체가 일어나지 않는다 — 위의 /healthz가
    # 무시되고 헬스체크가 계속 301을 받는다(실제로 그렇게 한 번 틀렸다).
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # 인증서는 도메인이 들어가지 않는 고정 경로에서 읽는다.
    #
    # Let's Encrypt는 /etc/letsencrypt/live/<도메인>/ 에 넣어 주는데, 그 경로를 여기
    # 적으면 도메인이 바뀔 때마다 이 .template을 고쳐야 한다. live/ 안의 것은 심볼릭
    # 링크라 그 폴더만 마운트하면 링크가 끊긴다. 그래서 -L로 실체를 복사해 둔다:
    #
    #   sudo mkdir -p /etc/nginx-certs
    #   sudo cp -L /etc/letsencrypt/live/<도메인>/fullchain.pem /etc/nginx-certs/
    #   sudo cp -L /etc/letsencrypt/live/<도메인>/privkey.pem   /etc/nginx-certs/
    #
    # 이 두 파일이 없으면 nginx가 아예 뜨지 않는다. 인증서를 먼저 받고 배포해야 한다.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 서버 종류·버전을 응답 헤더에서 지운다. 알려진 취약점을 가진 버전을 광고할
    # 이유가 없다.
    server_tokens off;

    # 상담 녹음 파일이 올라간다. 기본값 1MB로는 즉시 413이 난다.
    # core-api application.yaml의 multipart 설정(200MB)과 맞춘다.
    client_max_body_size 210M;

    # ── 정적 파일 (React 빌드 결과) ─────────────────────────────────────────
    root /usr/share/nginx/html;
    index index.html;

    # 해시가 붙은 자산은 내용이 바뀌면 파일명이 바뀌므로 오래 캐시해도 안전하다.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── core-api ───────────────────────────────────────────────────────────
    # 프론트는 /core-api/** 로 부른다(coreApiClientV2.js CORE_API_BASE_URL).
    # 로컬에서 Vite가 하던 rewrite를 여기서 그대로 한다 — 접두사를 떼고 넘긴다.
    location /core-api/ {
        proxy_pass http://core_api/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # AI 분석은 수 분이 걸린다. 기본 60초로는 정상 요청이 504로 끊긴다.
        proxy_read_timeout    1200s;
        proxy_send_timeout    1200s;
        proxy_connect_timeout 30s;

        # 파일 업로드를 디스크에 모았다가 보내지 않고 그대로 흘려보낸다.
        # 200MB 녹음을 버퍼링하면 디스크와 지연이 모두 낭비된다.
        proxy_request_buffering off;
    }

    # ── 브라우저 ↔ core-api WebSocket (대면 녹음, 상담원 화면) ──────────────
    location /ws/ {
        proxy_pass http://core_api;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;

        # 녹음은 길게 이어진다. 말이 없는 동안에도 끊기면 안 되므로 넉넉히 둔다.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Twilio → VoIP 게이트웨이 ───────────────────────────────────────────
    # 바깥에서 닿아야 하는 유일한 백엔드 경로다. POST(TwiML 요청)와
    # WebSocket(오디오 스트림)이 같은 경로로 오므로 업그레이드 헤더를 함께 넘긴다.
    #
    # 주의: 여기는 인증이 없다. Twilio 서명 검증(X-Twilio-Signature)을 붙이기 전까지는
    # 아무나 전화 세션을 흉내 낼 수 있다. 배포 전 반드시 확인할 것.
    location /webhook {
        proxy_pass http://voip_gateway;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── SPA 폴백 ───────────────────────────────────────────────────────────
    # 라우터가 없는 앱이지만 /privacy.html·/terms.html 같은 정적 문서가 있으므로
    # 파일이 있으면 그걸 주고, 없을 때만 index.html로 떨어뜨린다.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
