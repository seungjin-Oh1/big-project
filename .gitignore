# 오늘 작업 산출물
# 초안·검증결과 (outputs 아니라 output임!)
backend/ai-api/output/
# 파이프라인 회차별 결과 비교용 폴더. 위 규칙이 backend/ai-api 아래만 가려서
# 저장소 루트에 쌓이는 이쪽은 계속 미추적으로 떴다.
/output/
# 변환된 서식 291개 (용량)
backend/ai-api/서식_hwpx/
# 원본 hwp 풀어놓은 폴더
backend/ai-api/서식/
변환결과.json
*.txt
# 단, 의존성 목록은 예외. 위 *.txt는 서식 변환 부산물을 걸러내려는 것인데, 새로 만드는
# requirements.txt까지 같이 삼켜서 add해도 아무 말 없이 무시된다(ai-api/requirements.txt는
# 이 규칙보다 먼저 커밋돼 살아남은 것뿐이라 문제가 드러나지 않았다).
!requirements.txt

backend/ai-api/rag/data/parsed_templates.json

# 서버 실행 로그 (uvicorn, bootRun 등)
*.log

# 로컬 검증용 스크립트·목 데이터 (팀 공용 테스트가 아니라 각자 돌려보는 용도)
backend/ai-api/test_*.py
backend/ai-api/custom_mocks/

# ?? RAG ?? ???
backend/ai-api/storage/

# TTS로 만든 상담 목업 음성. 231MB / 578개다. 다시 만들 수 있고
# (tts-mock/generate_tts_single.py) 레포에 넣을 크기가 아니다.
tts-mock/mock_audio/

# AWS에 만든 리소스의 ID 기록. 계정마다 값이 다르므로 공유 대상이 아니다.
# deploy/aws/create_network.py가 쓰고 teardown이 읽는다.
# RDS 비밀번호도 여기 들어간다.
deploy/aws/state.json
# EC2 SSH 개인키. 이 저장소는 공개다 — 절대 커밋되면 안 된다.
deploy/aws/*.pem
# 배포 서버에 올리는 .env. AWS·OpenAI 키와 PII 암호화 키가 들어 있다.
# 다시 배포할 때 그대로 쓰려고 남겨 두는 것이지 공유 대상이 아니다.
deploy/aws/deploy.env.local
# teardown 전에 떠 둔 리소스 ID 기록
deploy/aws/backup/
