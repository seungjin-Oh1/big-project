# 배포용 환경변수 템플릿. `cp .env.deploy.example .env` 하고 값을 채운다.
#
# .env는 절대 커밋하지 않는다(.gitignore 확인). 여기 있는 값 하나가 새면
# 상담 원문 전체가 복호화된다.
#
# compose가 ${VAR:?...} 로 잡아 두어서, 빠뜨린 값이 있으면 컨테이너가 뜨기 전에
# 멈춘다. 조용히 기본값으로 도는 것보다 낫다.

# ── 공개 주소 ────────────────────────────────────────────────────────────────
# 브라우저가 접속하는 주소. CORS 허용 목록에 그대로 들어간다.
PUBLIC_ORIGIN=https://example.com

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
DB_NAME=bigproject
DB_USERNAME=
DB_PASSWORD=

# ── 시크릿 ───────────────────────────────────────────────────────────────────
# 32바이트 이상. `openssl rand -base64 48` 로 만든다.
JWT_SECRET=

# !!! 한 번 정하면 바꿀 수 없다 !!!
# 상담 원문·이름·주소·전화번호가 이 키로 암호화되어 저장된다. 키를 바꾸면 기존
# 데이터를 복호화할 수 없고, 되돌릴 방법이 없다. 만들자마자 안전한 곳에 따로 보관할 것.
PII_ENCRYPTION_KEY=

# 외부 게이트웨이(전화·대면 오디오)가 core-api에 붙을 때 쓰는 공유 비밀키.
# stt-mask-api-modal도 같은 값을 쓴다(compose가 알아서 넘긴다).
AUDIO_EXTERNAL_API_KEY=

# 마스터 계정 비밀번호. 비밀번호 규칙(대소문자·숫자·특수문자 포함 길이 제한)을 만족해야 한다.
MASTER_TALKER_PASSWORD=
MASTER_LAWYER_PASSWORD=
MASTER_ADMIN_PASSWORD=

# ── AWS ──────────────────────────────────────────────────────────────────────
# core-api가 첨부파일을 올리고 ai-api가 그걸 내려받는다. 반드시 같은 버킷이어야 한다.
# RAG 자산(Chroma 색인·서식)도 이 버킷의 deploy-assets/ 아래에 둔다.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
KLAC_GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=gpt-5.4-mini
WHISPER_MODEL_SIZE=base
# 국가법령정보 OPEN API 인증키(없으면 비워 둔다)
LAW_API_OC=

# ── 실시간 STT / 전화 ────────────────────────────────────────────────────────
# `modal deploy ./modal/modal_asr.py` 가 출력한 주소 + /ws/transcribe
# serve로 받은 -dev 주소를 쓰면 그 터미널을 닫는 순간 전사가 멈춘다.
MODAL_ASR_WS_URL=wss://<워크스페이스>--qwen3-asr-streaming-qwen3asrservice-web.modal.run/ws/transcribe

# Twilio(Clawops)가 통화 오디오를 밀어넣을 주소. PUBLIC_ORIGIN과 같은 도메인의
# /webhook 이고 프로토콜만 wss다. 전화번호 Webhook에는 https:// 로 넣는다.
STREAM_CALLBACK_URL=wss://example.com/webhook

# ── 프로파일 ─────────────────────────────────────────────────────────────────
# local/test가 아닌 값이어야 DevSecretGuard가 켜진다. 기본값 시크릿이 남아 있으면
# 기동을 거부한다.
SPRING_PROFILES_ACTIVE=prod
