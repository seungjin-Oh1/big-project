# Modal에 배포된 Qwen3-ASR 서비스의 wss:// URL (modal/modal_asr.py 참고).
# `modal deploy modal/modal_asr.py` 실행 시 출력된다.
MODAL_ASR_WS_URL=wss://<username>--qwen3-asr-streaming-qwen3asrservice-web-dev.modal.run/ws/transcribe

# ASR을 비활성화하려면 1/true/yes 중 하나로 설정한다.
DISABLE_ASR=

# 통화 오디오/transcript를 중계할 external audio ws 서버 주소와 인증 토큰.
EXTERNAL_AUDIO_WS_URL=ws://localhost:8080/ws/audio/external
EXTERNAL_AUDIO_AUTH_TOKEN=dev-only-external-audio-key-change-me

# Twilio가 통화 오디오를 스트리밍할 이 서버의 공개 wss:// 주소(예: ngrok 터널).
# 터널을 새로 열 때마다 바뀌므로 기기/세션마다 새로 설정한다.
STREAM_CALLBACK_URL=wss://<your-ngrok-subdomain>.ngrok-free.dev/webhook
